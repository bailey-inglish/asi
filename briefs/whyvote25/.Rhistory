View(anes_timeseries_2024_csv_20250808)
# rename data
anes24_open_end <- anes_timeseries_2024__merged_by_respondent
anes24_closed <- anes_timeseries_2024_csv_20250808
# merge together
# Check key presence
stopifnot("V24001" %in% names(anes24_open_end), "V24001" %in% names(anes24_closed))
# merge together
# Check key presence
stopifnot("V240001" %in% names(anes24_open_end), "V240001" %in% names(anes24_closed))
# If the types differ (e.g., one is character and the other is numeric), coerce consistently:
# Example: make both character
anes24_open_end  <- anes24_open_end  %>% mutate(V240001 = as.character(V240001))
# library
library(dplyr)
# library
library(tidyverse)
anes24_open_end  <- anes24_open_end  %>% mutate(V240001 = as.character(V240001))
anes24_closed    <- anes24_closed    %>% mutate(V240001 = as.character(V240001))
anes24_merged_left <- anes24_open_end %>%
left_join(anes24_closed, by = "V240001")
# anes24_merged_left brings in the matched information from the closed-end file to the
# open-end file.
anes24_merged_left <- anes24_open_end %>%
left_join(anes24_closed, by = "V240001")
# anes24_merged_inner only keeps observations present in both
anes24_merged_inner <- anes24_open_end %>%
inner_join(anes24_closed, by = "V240001")
# full join keeps observations present in both, but if an observation is unmatched, it becomes an NA
anes24_merged_full <- anes24_open_end %>%
full_join(anes24_closed, by = "V24001")
# full join keeps observations present in both, but if an observation is unmatched, it becomes an NA
anes24_merged_full <- anes24_open_end %>%
full_join(anes24_closed, by = "V240001")
# anes merged right keeps rows from closed, but brings in open-ended
anes24_merged_right <- anes24_open_end %>%
right_join(anes24_closed, by = "V240001")
View(anes24_merged_left)
table(V240001$V241012)
tableanes24_merged_left$V241012)
